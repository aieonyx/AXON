// Concrete type system for AXONYX type inference.
// Mirrored in Rust by ty.rs.
// P53 codegen emits LLVM IR based on these resolved types.

type TyVar = usize;

enum Ty {
    I32, I64, F64, Bool, Str, Nil,
    Named(str),
    Var(TyVar),
    Unknown,
}

fn ty_from_name(name: str) -> Ty {
    match name {
        "i32"  => Ty::I32,
        "i64"  => Ty::I64,
        "f64"  => Ty::F64,
        "bool" => Ty::Bool,
        "str"  => Ty::Str,
        "nil"  => Ty::Nil,
        _      => Ty::Named(name),
    }
}

fn ty_from_hir(hir_ty: HirTy) -> Ty {
    match hir_ty {
        HirTy::Named(n) => ty_from_name(n),
        HirTy::Infer    => Ty::Unknown,
    }
}

fn ty_is_numeric(ty: Ty) -> bool {
    match ty {
        Ty::I32 | Ty::I64 | Ty::F64 => true,
        _                            => false,
    }
}
