//
// High-level Intermediate Representation for AXONYX.
// Mirrored in Rust by hir.rs.
// P52 type inference fills HirTy::Infer slots.
// P55.5: sovereign/security/finance HIR types added.

type HirId = usize;

// HIR type
enum HirTy {
    Named(str),
    Infer,
    // v0.3 sovereign types
    Tainted(Box<HirTy>),
    Clean(Box<HirTy>),
    Secret(Box<HirTy>),
    Auditable(Box<HirTy>),
    Expires { inner: Box<HirTy>, after_ms: i64 },
    Resident { inner: Box<HirTy>, jurisdiction: str },
    Money { currency: str, precision: i64 },
    SafeInt { lo: i64, hi: i64 },
    Refinement { base: Box<HirTy>, pred: str },
    Opaque { name: str, inner: Box<HirTy> },
}

// HIR decorator
enum HirDecorator {
    Deterministic,
    ConstantTime,
    AiSpecialize(str),
    AiIntent(str),
    AiVerify { pre: str, post: str, invariant: str },
    Ensures(str),
    RequiresConsent { user_id: str, purpose: str },
    SealedMemory,
    Balanced,
    AtomicFinancial,
    ModelSigned(str),
    InferenceBudget { tokens: i64, time_ms: i64 },
    RequiresHumanApproval(str),
}

enum HirBinOp {
    Add, Sub, Mul, Div, Mod,
    Eq, Ne, Lt, Le, Gt, Ge,
    And, Or,
}

enum HirUnaryOp { Neg, Not }

enum HirCapPin { Required, Optional }

enum HirExpr {
    IntLit(i64),
    FloatLit(f64),
    StringLit(str),
    BoolLit(bool),
    Nil,
    Var(str),
    BinOp { op: HirBinOp, lhs: Box<HirExpr>, rhs: Box<HirExpr> },
    UnaryOp { op: HirUnaryOp, expr: Box<HirExpr> },
    Call { name: str, args: [HirExpr] },
    If { cond: Box<HirExpr>, then: [HirStmt], else_: Option<[HirStmt]> },

    // v0.3 expressions
    Pipe { lhs: Box<HirExpr>, rhs: Box<HirExpr>, contract: Option<str> },
    Morph { expr: Box<HirExpr>, method: str },
    CapPinCall { expr: Box<HirExpr>, method: str, pin: HirCapPin },
    Temporal(HirTemporalKind),
    Foreach { var: str, gen: Box<HirExpr>, body: [HirStmt] },
    Yield(Box<HirExpr>),
    IntentBlock { modes: [str], body: [HirStmt] },
}

enum HirTemporalKind { Now, Lifetime, Epoch }

enum HirStmt {
    Let { name: str, mutable: bool, ty: HirTy, value: HirExpr },
    LetAt { name: str, ty: HirTy, value: HirExpr },  // ephemeral — zeroized on drop
    Return(HirExpr),
    ExprStmt(HirExpr),
}

struct HirParam { name: str, ty: HirTy }
struct HirField { name: str, ty: HirTy }

struct HirHandleBlock {
    msg_name: str,
    msg_ty:   HirTy,
    ret_ty:   HirTy,
    body:     [HirStmt],
}

struct HirFn {
    id:         HirId,
    decorators: [HirDecorator],
    name:       str,
    uses:       [str],
    params:     [HirParam],
    ret:        HirTy,
    body:       [HirStmt],
}

struct HirStruct {
    id:     HirId,
    name:   str,
    fields: [HirField],
}

struct HirActor {
    id:      HirId,
    name:    str,
    handles: [HirHandleBlock],
}

struct HirProgram {
    fns:     [HirFn],
    structs: [HirStruct],
    actors:  [HirActor],
}

fn hir_program_new() -> HirProgram {
    HirProgram { fns: [], structs: [], actors: [] }
}
